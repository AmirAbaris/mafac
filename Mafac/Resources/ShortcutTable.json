{
  "version": 1,
  "entries": [
    {
      "id": "root",
      "trigger": "r",
      "tier": 1,
      "category": "structure",
      "latex": "\\sqrt{}",
      "symbol": "√",
      "holeBehavior": "single",
      "mnemonic": "r = root"
    },
    {
      "id": "integral",
      "trigger": "i",
      "tier": 1,
      "category": "calculus",
      "latex": "\\int_{}^{}",
      "symbol": "∫",
      "holeBehavior": "double",
      "mnemonic": "i = integral; holes are the lower/upper bounds, integrand is typed after exiting the holes"
    },
    {
      "id": "sum",
      "trigger": "s",
      "tier": 1,
      "category": "calculus",
      "latex": "\\sum_{}^{}",
      "symbol": "Σ",
      "holeBehavior": "double",
      "mnemonic": "s = sum; holes are the lower/upper bounds"
    },
    {
      "id": "pi",
      "trigger": "p",
      "tier": 1,
      "category": "constant",
      "latex": "\\pi",
      "symbol": "π",
      "holeBehavior": "none",
      "mnemonic": "p = pi"
    },
    {
      "id": "infinity",
      "trigger": "8",
      "tier": 1,
      "category": "constant",
      "latex": "\\infty",
      "symbol": "∞",
      "holeBehavior": "none",
      "mnemonic": "8 = sideways figure-eight looks like the infinity symbol"
    },
    {
      "id": "fraction",
      "trigger": "f",
      "tier": 1,
      "category": "structure",
      "latex": "\\frac{}{}",
      "symbol": "a/b",
      "holeBehavior": "double",
      "mnemonic": "f = fraction; first hole is numerator, second is denominator"
    },
    {
      "id": "superscript",
      "trigger": "^",
      "tier": 1,
      "category": "structure",
      "latex": "^{}",
      "symbol": "xⁿ",
      "holeBehavior": "single",
      "mnemonic": "^ is the literal LaTeX superscript operator, so it types itself"
    },
    {
      "id": "subscript",
      "trigger": "_",
      "tier": 1,
      "category": "structure",
      "latex": "_{}",
      "symbol": "xₙ",
      "holeBehavior": "single",
      "mnemonic": "_ is the literal LaTeX subscript operator, so it types itself"
    },
    {
      "id": "leq",
      "trigger": "<",
      "tier": 1,
      "category": "relation",
      "latex": "\\leq",
      "symbol": "≤",
      "holeBehavior": "none",
      "mnemonic": "< is the base less-than key; ≤ is its \"or equal\" cousin"
    },
    {
      "id": "geq",
      "trigger": ">",
      "tier": 1,
      "category": "relation",
      "latex": "\\geq",
      "symbol": "≥",
      "holeBehavior": "none",
      "mnemonic": "> is the base greater-than key; ≥ is its \"or equal\" cousin"
    },
    {
      "id": "to",
      "trigger": "-",
      "tier": 1,
      "category": "relation",
      "latex": "\\to",
      "symbol": "→",
      "holeBehavior": "none",
      "mnemonic": "- is the dash you'd type to start drawing \"->\" by hand"
    },
    {
      "id": "neq",
      "trigger": "n",
      "tier": 1,
      "category": "relation",
      "latex": "\\neq",
      "symbol": "≠",
      "holeBehavior": "none",
      "mnemonic": "n = not (equal)"
    },
    {
      "id": "pm",
      "trigger": "m",
      "tier": 1,
      "category": "operator",
      "latex": "\\pm",
      "symbol": "±",
      "holeBehavior": "none",
      "mnemonic": "m = second letter of \"pm\" (p is already taken by pi)"
    },
    {
      "id": "times",
      "trigger": "x",
      "tier": 1,
      "category": "operator",
      "latex": "\\times",
      "symbol": "×",
      "holeBehavior": "none",
      "mnemonic": "x is visually identical to the multiplication sign ×"
    },
    {
      "id": "div",
      "trigger": "/",
      "tier": 1,
      "category": "operator",
      "latex": "\\div",
      "symbol": "÷",
      "holeBehavior": "none",
      "mnemonic": "/ is the slash that sits inside the division sign ÷"
    },
    {
      "id": "approx",
      "trigger": "~",
      "tier": 1,
      "category": "relation",
      "latex": "\\approx",
      "symbol": "≈",
      "holeBehavior": "none",
      "mnemonic": "~ (tilde) is visually one of the two wavy bars in ≈"
    },
    {
      "id": "in",
      "trigger": "e",
      "tier": 1,
      "category": "relation",
      "latex": "\\in",
      "symbol": "∈",
      "holeBehavior": "none",
      "mnemonic": "e = element of"
    },
