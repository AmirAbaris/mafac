      "latex": "\\alpha",
      "symbol": "α",
      "holeBehavior": "none",
      "mnemonic": "a = alpha"
    },
    {
      "id": "beta",
      "trigger": "b",
      "tier": 1,
      "category": "greek",
      "latex": "\\beta",
      "symbol": "β",
      "holeBehavior": "none",
      "mnemonic": "b = beta"
    },
    {
      "id": "gamma",
      "trigger": "g",
      "tier": 1,
      "category": "greek",
      "latex": "\\gamma",
      "symbol": "γ",
      "holeBehavior": "none",
      "mnemonic": "g = gamma"
    },
    {
      "id": "delta",
      "trigger": "d",
      "tier": 1,
      "category": "greek",
      "latex": "\\delta",
      "symbol": "δ",
      "holeBehavior": "none",
      "mnemonic": "d = delta"
    },
    {
      "id": "theta",
      "trigger": "t",
      "tier": 1,
      "category": "greek",
      "latex": "\\theta",
      "symbol": "θ",
      "holeBehavior": "none",
      "mnemonic": "t = theta (\"th\" sound)"
    },
    {
      "id": "lambda",
      "trigger": "l",
      "tier": 1,
      "category": "greek",
      "latex": "\\lambda",
      "symbol": "λ",
      "holeBehavior": "none",
      "mnemonic": "l = lambda"
    },
    {
      "id": "mu",
      "trigger": "u",
      "tier": 1,
      "category": "greek",
      "latex": "\\mu",
      "symbol": "μ",
      "holeBehavior": "none",
      "mnemonic": "u = second letter of \"mu\" (m is already taken by ±)"
    },
    {
      "id": "omega",
      "trigger": "o",
      "tier": 1,
      "category": "greek",
      "latex": "\\omega",
      "symbol": "ω",
      "holeBehavior": "none",
      "mnemonic": "o = omega"
    },
    {
      "id": "forall",
      "trigger": ";f",
      "tier": 2,
      "category": "logic",
      "latex": "\\forall",
      "symbol": "∀",
      "holeBehavior": "none",
      "mnemonic": "leader ; + f = \"for all\" (plain f is already taken by fraction)"
    },
    {
      "id": "exists",
      "trigger": ";e",
      "tier": 2,
      "category": "logic",
      "latex": "\\exists",
      "symbol": "∃",
      "holeBehavior": "none",
      "mnemonic": "leader ; + e = exists (plain e is already taken by \\in)"
    },
    {
      "id": "product",
      "trigger": ";p",
      "tier": 2,
      "category": "calculus",
      "latex": "\\prod_{}^{}",
      "symbol": "∏",
      "holeBehavior": "double",
      "mnemonic": "leader ; + p = product, capital-Pi sibling of sum (plain p is already taken by pi)"
    }
  ]
}
